#!/bin/sh
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

# This file prints an attended, read-only test plan. It never toggles a tunnel,
# starts or stops a VM, changes routes/firewalls, sends an exchange action, or
# executes any command that it prints.
if [ "$#" -ne 1 ] || [ "$1" != "--plan" ]; then
    printf '%s\n' \
        'local_nat_lab_test_apply_disabled: only --plan is accepted' >&2
    exit 64
fi

cat <<'EOF'
apply_enabled=false
test_execution_enabled=false
application_route_gate_default_ready=false
trusted_route_health_collector_configured=false
route_health_evidence_durably_bound=false
mode=local_nat_lab
macos_full_tunnel_routes_emitted=true
macos_pf_kill_switch_emitted=false
remote_vpn_exit_configured=false
vpn_qualified=false
expected_public_ip_change=false
expected_router_endpoint=__REVIEWED_ROUTER_ENDPOINT__
expected_dns=__REVIEWED_DNS_IPV4__
expected_guest_wan=__REVIEWED_WAN_INTERFACE__
expected_guest_ingress=__REVIEWED_INGRESS_INTERFACE__
operator_step_01=With the Mac tunnel off, retain the IPv4 and IPv6 route tables and output from a reviewed public-IP observer.
operator_step_02=Start the already-qualified VM from its attended console; then activate the app-owned Mac WireGuard tunnel.
operator_step_03=Prove both default routes select the WireGuard utun and retain the exact utun identity.
operator_step_04=Run the guest router check and retain its recent-handshake output.
operator_step_05=Record the guest IPv6 pre-routing ingress counter and IPv4 forward drop counter before the negative probes.
operator_step_06=Run allowed DNS and unsigned TESTNET info reads; do not call an exchange action endpoint.
operator_step_07=Run the IPv6 probe; it must fail and increment the pre-routing IPv6 ingress counter while forwarding stays disabled and the WAN has no IPv6 default route or global address; no forward-drop increment is required.
operator_step_08=Run alternate-DNS, DoT, QUIC and unreviewed-port IPv4 probes; each must fail and increment the wg-exec forward drop counter.
operator_step_09=Capture a second Mac route snapshot and guest health block; require unchanged topology/routes, non-regressing WireGuard transfer counters and an increased accepted-HTTPS counter around the read-only TESTNET info probe.
operator_step_10=Recheck the public IP; it must equal the tunnel-off value in local_nat_lab.
operator_step_11=Stop the tunnel and VM separately and record physical-route fallback; fallback is expected and proves there is no host kill switch.
mac_command_routes_ipv4=/usr/sbin/netstat -rn -f inet
mac_command_routes_ipv6=/usr/sbin/netstat -rn -f inet6
mac_command_route_dns=/sbin/route -n get __REVIEWED_DNS_IPV4__
mac_command_route_ipv6=/sbin/route -n get -inet6 2606:4700:4700::1111
guest_command_router_check=sudo /usr/local/libexec/trading-desk-router-check
guest_command_ipv6_ingress_counter=sudo nft -nn list chain inet trading_desk_filter prerouting_observe
guest_command_ipv4_drop_counter=sudo nft -nn list chain inet trading_desk_filter forward
guest_command_ipv6_forwarding=cat /proc/sys/net/ipv6/conf/all/forwarding
guest_command_ipv6_default_route=ip -6 route show default
guest_command_ipv6_wan_global_address=ip -o -6 address show dev __REVIEWED_WAN_INTERFACE__ scope global
mac_command_allowed_dns=/usr/bin/dig +time=3 +tries=1 @__REVIEWED_DNS_IPV4__ api.hyperliquid-testnet.xyz A
mac_command_unsigned_info=/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin /usr/bin/curl -q --noproxy '*' --fail --silent --show-error --proto '=https' --tlsv1.2 --max-time 10 -H 'Content-Type: application/json' --data-binary '{"type":"meta"}' https://api.hyperliquid-testnet.xyz/info
mac_command_tls_ws_endpoint=/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin /usr/bin/openssl s_client -connect api.hyperliquid-testnet.xyz:443 -servername api.hyperliquid-testnet.xyz -verify_return_error </dev/null
websocket_upgrade_requirement=The TLS command proves only TLS reachability; separately retain an HTTP 101 upgrade from a reviewed credential-free WebSocket client without sending a subscription or action.
mac_command_block_ipv6=/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin /usr/bin/curl -q --noproxy '*' --fail --silent --show-error --ipv6 --proto '=https' --tlsv1.2 --max-time 5 https://www.cloudflare.com/cdn-cgi/trace
mac_command_block_alternate_dns=/usr/bin/dig +time=3 +tries=1 @8.8.8.8 api.hyperliquid-testnet.xyz A
mac_command_block_dot=/usr/bin/nc -G 3 -vz 1.1.1.1 853
mac_command_block_unreviewed_tcp=/usr/bin/nc -G 3 -vz 1.1.1.1 80
quic_test_requirement=Generate one bounded IPv4 UDP/443 probe while watching the guest wg-exec forward drop counter; a UDP client exit code alone is not evidence.
public_ip_requirement=Use one reviewed HTTPS observer before and after; retain raw responses and require exact equality.
route_health_evidence_contract=Two stable samples, reviewed manifest/config/topology bindings, a recent handshake and an accepted-HTTPS counter increase are required; this plan does not collect or authorize them.
evidence_status=awaiting_vm_apply_router_keys_and_attended_local_nat_lab_test
EOF
